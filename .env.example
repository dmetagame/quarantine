# Target-neutral hosted-demo configuration. Copy this to .env.deploy and keep
# the copy private. scripts/bootstrap-deployment.sh generates the secret files.
HYDRA_IMAGE=ghcr.io/hydra-db/hydradb:0.1.1@sha256:db78309a233be54662db29744047e985a39b51c45a270d1a1f47c31a62cdb709
HYDRA_NAMESPACE=default
HYDRA_GRAPH_ID=default
HYDRA_CELL_ID=cell-0
HYDRA_UID=1000
HYDRA_GID=1000
HYDRA_DATA_DIR=./.hydradb-hosted-data
HYDRA_AUTH_TOKEN_FILE=./.secrets/hydra-auth-token
QUARANTINE_PROVENANCE_SIGNING_KEY_FILE=./.secrets/provenance-signing-key
QUARANTINE_CONNECTOR_ATTESTATION_KEY_FILE=./.secrets/connector-attestation-key
HYDRA_HTTP_PORT=18443
HYDRA_ADMIN_PORT=19091
QUARANTINE_DEMO_BIND=127.0.0.1
QUARANTINE_DEMO_PORT=4173
